    <Compile Include="..\..\Services\AppStorage.cs" Link="App\Services\AppStorage.cs" />
    <Compile Include="..\..\Services\DiagnosticLog.cs" Link="App\Services\DiagnosticLog.cs" />
    <Compile Include="..\..\Services\ShutdownPortForwarder.cs" Link="App\Services\ShutdownPortForwarder.cs" />
    <Compile Include="..\..\Localization\L.cs" Link="App\Localization\L.cs" />
