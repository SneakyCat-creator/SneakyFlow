    <Compile Include="..\..\Services\DhtBootstrap.cs" Link="App\Services\DhtBootstrap.cs" />
  </ItemGroup>
  <ItemGroup><Compile Include="..\..\Services\SwitchingPieceRequester.cs" Link="App\Services\SwitchingPieceRequester.cs" /></ItemGroup>
  <ItemGroup><Compile Include="..\..\Services\StallRecovery.cs" Link="App\Services\StallRecovery.cs" /></ItemGroup>
