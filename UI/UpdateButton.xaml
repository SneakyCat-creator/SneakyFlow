<UserControl x:Class="SneakyFlow.UI.UpdateButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Width="260" Height="40">
  <Button x:Name="ActionButton" Click="Action_Click" DataContext="{Binding State, ElementName=Root}"
          IsEnabled="{Binding CanClick}" AutomationProperties.Name="{Binding AccessibleName}">
    <Button.Style>
      <Style TargetType="Button">
        <Setter Property="Background" Value="#27323D"/><Setter Property="Foreground" Value="#C9CEC7"/>
        <Setter Property="BorderBrush" Value="#40515D"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
              <Grid.Clip><RectangleGeometry Rect="0,0,258,38" RadiusX="7" RadiusY="7"/></Grid.Clip>
              <ProgressBar x:Name="Fill" Value="{Binding Percent, Mode=OneWay}" Minimum="0" Maximum="100" Height="38" Foreground="#345B50" Background="Transparent" IsHitTestVisible="False">
                <ProgressBar.Style><Style TargetType="ProgressBar">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/></Grid></ControlTemplate></Setter.Value></Setter>
                  <Style.Triggers><DataTrigger Binding="{Binding HasPercent}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style></ProgressBar.Style>
              </ProgressBar>
              <Grid Margin="12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid x:Name="Spinner" Width="14" Height="14" Margin="0,0,9,0" Visibility="Collapsed" VerticalAlignment="Center">
                  <Path Data="M 7,2 A 5,5 0 1 1 2,7" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><RotateTransform x:Name="SpinnerRotation"/></Path.RenderTransform>
                  </Path>
                </Grid>
                <TextBlock x:Name="Label" Grid.Column="1" Text="{Binding Label}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock x:Name="Percent" Grid.Column="2" Width="40" Margin="8,0,0,0" Text="{Binding PercentText}" TextAlignment="Right" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Visibility="Collapsed" Typography.NumeralAlignment="Tabular"/>
              </Grid>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding HasPercent}" Value="True"><Setter TargetName="Percent" Property="Visibility" Value="Visible"/><Setter TargetName="Label" Property="HorizontalAlignment" Value="Left"/></DataTrigger>
            <DataTrigger Binding="{Binding IsInstalling}" Value="True"><Setter TargetName="Fill" Property="Foreground" Value="#364F63"/><Setter TargetName="Surface" Property="BorderBrush" Value="#6D8FA5"/></DataTrigger>
            <DataTrigger Binding="{Binding IsSuccess}" Value="True"><Setter TargetName="Surface" Property="Background" Value="#254B3C"/><Setter TargetName="Surface" Property="BorderBrush" Value="#558C73"/><Setter Property="Foreground" Value="#A9D8BA"/><Setter TargetName="Fill" Property="Foreground" Value="#254B3C"/></DataTrigger>
            <DataTrigger Binding="{Binding IsError}" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A27067"/><Setter Property="Foreground" Value="#E0ABA0"/></DataTrigger>
            <DataTrigger Binding="{Binding IsIndeterminate}" Value="True">
              <Setter TargetName="Spinner" Property="Visibility" Value="Visible"/>
              <DataTrigger.EnterActions><BeginStoryboard x:Name="Spin"><Storyboard><DoubleAnimation Storyboard.TargetName="SpinnerRotation" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
              <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="Spin"/></DataTrigger.ExitActions>
            </DataTrigger>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Surface" Property="BorderBrush" Value="#7DC5AB"/></MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#7DC5AB"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style>
    </Button.Style>
  </Button>
</UserControl>
